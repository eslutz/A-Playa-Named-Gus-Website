<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <link rel="icon" href="/assets/gus-mark.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/gus-mark.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="preload" href="/assets/fonts/MonaSans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  {% if canonical %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:site_name" content="A Playa Named Gus">
  {% endif %}
</head>
<body>
  <header class="site-header">
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="/"{% if navCurrent == "home" %} aria-current="page"{% endif %}>
        <img src="/assets/gus-mark.svg" alt="" width="34" height="34">
        <span>A Playa Named Gus</span>
      </a>
      <div class="nav-links">
        <a href="/support"{% if navCurrent == "support" %} aria-current="page"{% endif %}>Support</a>
        <a href="/privacy"{% if navCurrent == "privacy" %} aria-current="page"{% endif %}>Privacy</a>
        <a href="/accessibility"{% if navCurrent == "accessibility" %} aria-current="page"{% endif %}>Accessibility</a>
        <a href="/age-suitability"{% if navCurrent == "age-suitability" %} aria-current="page"{% endif %}>Age Suitability</a>
      </div>
    </nav>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="footer-groups">
      <nav class="footer-group" aria-label="Site pages">
        <h2>Site</h2>
        <a href="/">Home</a>
        <a href="/support">Support</a>
      </nav>
      <nav class="footer-group" aria-label="Site policies">
        <h2>Policies</h2>
        <a href="/privacy">Privacy</a>
        <a href="/accessibility">Accessibility</a>
        <a href="/age-suitability">Age Suitability</a>
      </nav>
      <nav class="footer-group" aria-label="Project links">
        <h2>Project</h2>
        <a href="https://github.com/eslutz/A-Playa-Named-Gus" target="_blank" rel="noopener noreferrer">Repo</a>
        <a href="https://github.com/eslutz/A-Playa-Named-Gus/wiki" target="_blank" rel="noopener noreferrer">Wiki</a>
        <a href="https://github.com/eslutz/A-Playa-Named-Gus/discussions" target="_blank" rel="noopener noreferrer">Discussions</a>
      </nav>
      <nav class="footer-group" aria-label="Developer links">
        <h2>Developer</h2>
        <a href="https://ericslutz.dev" target="_blank" rel="noopener noreferrer">ericslutz.dev</a>
      </nav>
      <nav class="footer-group" aria-label="Media server links">
        <h2>Media Servers</h2>
        <a href="https://jellyfin.org/" target="_blank" rel="noopener noreferrer">Jellyfin.org</a>
      </nav>
    </div>
    <div class="footer-legal">
      <p>A Playa Named Gus is not affiliated with Jellyfin. A Jellyfin server is required.</p>
      <p>&copy; 2026 Eric Slutz. A Playa Named Gus is source-available / All Rights Reserved.</p>
    </div>
  </footer>
</body>
</html>
